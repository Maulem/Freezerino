rules_version = '2';

// Only the shared family account (familia@freezerino.app) can read or change anything.
service cloud.firestore {
  match /databases/{database}/documents {
    function isFamily() {
      return request.auth != null && request.auth.uid == "d4kT46A33gZTfTlcfErrkvUv5mq2";
    }

    function validItem(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.place in ["p1", "p2", "p3", "g1", "g2"]
        && (d.qty == null || (d.qty is int && d.qty >= 0 && d.qty <= 999));
    }

    match /items/{id} {
      allow read, delete: if isFamily();
      allow create, update: if isFamily() && validItem(request.resource.data);
    }

    match /meta/{id} {
      allow read, write: if isFamily();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
