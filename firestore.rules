rules_version = '2';

// Only the shared family account (familia@freezerino.app) can read or change anything.
service cloud.firestore {
  match /databases/{database}/documents {
    function isFamily() {
      return request.auth != null && request.auth.uid == "0HzD6Q9KIha2uRtz2dHU1ObkPLY2";
    }

    function optInt(d, f, lo, hi) {
      return !(f in d) || d[f] == null || (d[f] is int && d[f] >= lo && d[f] <= hi);
    }

    // units: one entry per package, the date (ms) it went in, or null if unknown.
    function validItem(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.place is string && d.place.size() > 0 && d.place.size() <= 60
        && (!('units' in d) || (d.units is list && d.units.size() <= 500))
        && optInt(d, 'min', 0, 999)
        && optInt(d, 'shelfMonths', 1, 60);
    }

    match /items/{id} {
      allow read, delete: if isFamily();
      allow create, update: if isFamily() && validItem(request.resource.data);
    }

    match /places/{id} {
      allow read, delete: if isFamily();
      allow create, update: if isFamily()
        && request.resource.data.label is string
        && request.resource.data.label.size() > 0 && request.resource.data.label.size() <= 40
        && request.resource.data.order is number;
    }

    match /shopping/{id} {
      allow read, delete: if isFamily();
      allow create, update: if isFamily()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.done is bool;
    }

    // Phones that want expiry notifications (push address from Firebase Cloud Messaging).
    match /devices/{id} {
      allow read, delete: if isFamily();
      allow create, update: if isFamily()
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0 && request.resource.data.token.size() <= 4096
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 40));
    }

    // History: who put in or took out what. Phones can only add entries; old ones are removed by the daily job.
    match /log/{id} {
      allow read: if isFamily();
      allow create: if isFamily()
        && request.resource.data.at is int
        && request.resource.data.who is string && request.resource.data.who.size() <= 40
        && request.resource.data.item is string && request.resource.data.item.size() <= 80
        && request.resource.data.kind is string && request.resource.data.kind.size() <= 12;
      allow update, delete: if false;
    }

    match /meta/{id} {
      allow read, write: if isFamily();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
